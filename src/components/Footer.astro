---
import contact from '../data/contact.json';
import { inlineLogo } from '../data/logo';
---

<footer class="bg-negro text-crema">
  <div class="flex h-[6px]" aria-hidden="true">
    <span class="flex-1 bg-verde"></span><span class="flex-1 bg-marron"></span><span class="flex-1 bg-turquesa"></span>
  </div>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-8 sm:px-6">
    <span class="font-display text-2xl uppercase tracking-wide"><span class="text-verde-claro">Edith</span> Jordan</span>
    <div class="flex items-center gap-5">
      <span class="hidden text-sm text-crema/60 sm:inline">© Edith Jordan. 2026</span>
      <a
        href={contact.instagramUrl}
        target="_blank"
        rel="noopener"
        class="grid h-11 w-11 place-items-center rounded-full border-2 border-crema/20 transition-colors hover:border-turquesa hover:bg-turquesa hover:text-negro"
        aria-label="Instagram"
      >
        <span class="h-5 w-5" set:html={inlineLogo('instagram')} />
      </a>
    </div>
  </div>
  <!-- En móvil el copyright baja a su propia línea para no apretar el logo. -->
  <p class="px-4 pb-6 text-sm text-crema/60 sm:hidden">© Edith Jordan. 2026</p>
</footer>
