---
import { getCollection } from 'astro:content';
import { asset } from '../data/asset';
import { altFor, getLang, localized, useT } from '../i18n/ui';
import grouping from '../data/grouping.json';
import Groups from './Groups.astro';
import Mural from './Mural.astro';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [titleA, titleB] = t('photo.title');

const events = (await getCollection('events'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .filter((e) => e.data.photos.length > 0);

// El primer elemento es el grande del bento; el resto ocupa una celda.
const spans = ['col-span-2 row-span-2', '', '', '', ''];
const fmt = new Intl.DateTimeFormat(lang, { month: 'short', year: 'numeric' });
const title = (e: (typeof events)[number]) => localized(e.data, 'title', lang);
const allPhotos = events.flatMap((e) =>
  e.data.photos.map((p, j) => ({ src: asset(p.src), title: title(e), alt: altFor(p, title(e), j + 1, lang) })),
);
---

{events.length > 0 && (
<section id="fotografia" class="relative overflow-hidden py-24">
  <span class="pointer-events-none absolute -right-6 top-6 select-none font-display text-[22vw] leading-none text-verde/[0.06]" aria-hidden="true">{titleA}</span>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="font-display text-7xl uppercase leading-none tracking-wide">
      {titleA}<span class="text-verde dark:text-verde-claro">{titleB}</span>
    </h2>
    <div class="mt-2 h-[6px] w-20 bg-marron"></div>

    <div class="mt-10">
      {grouping.events ? (
        <Groups groups={events.map((e) => ({ title: title(e), label: fmt.format(e.data.date) }))} autoplay stack>
          {(i: number) => (
            <div class="grid aspect-[2/3] grid-cols-2 grid-rows-3 gap-2 sm:gap-3 md:aspect-[16/9] md:grid-cols-4 md:grid-rows-2">
              {events[i].data.photos.slice(0, 5).map((photo, j) => {
                const alt = altFor(photo, title(events[i]), j + 1, lang);
                return (
                <button class:list={['group relative overflow-hidden bg-fondo-2', spans[j]]} data-lightbox={asset(photo.src)} data-alt={alt} aria-label={`${t('enlarge')}: ${alt}`}>
                  <img
                    src={asset(photo.src)}
                    alt={alt}
                    decoding="async"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                  <span class="absolute inset-0 bg-verde/0 transition-colors group-hover:bg-verde/15"></span>
                </button>
                );
              })}
            </div>
          )}
        </Groups>
      ) : (
        <Mural photos={allPhotos} />
      )}
    </div>
  </div>
</section>
)}
