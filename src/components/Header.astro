---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { visibleNavLinks } from '../data/sections';
import { getLang, languages, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const navLinks = await visibleNavLinks();
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-texto/10 bg-fondo/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="#inicio" class="font-display text-3xl uppercase tracking-wide"><span class="text-verde dark:text-verde-claro">Edith</span>&nbsp;Jordan</a>

    <div class="flex items-center gap-3 sm:gap-4 xl:gap-6">
      <ul class="mr-2 hidden gap-6 text-sm font-bold uppercase tracking-[0.15em] xl:flex">
        {navLinks.map((l) => (
          <li><a href={l.href} class="nav-link border-b-[3px] border-transparent py-1 transition-colors hover:text-verde aria-[current]:border-turquesa dark:hover:text-verde-claro">{t(l.key)}</a></li>
        ))}
      </ul>

      <div class="flex items-center rounded-full border-2 border-texto/15 p-0.5 text-xs font-bold tracking-[0.15em]">
        {Object.entries(languages).map(([code, label]) => (
          <a
            href={getRelativeLocaleUrl(code)}
            hreflang={code}
            aria-current={code === lang ? 'page' : undefined}
            class="rounded-full px-2.5 py-1 transition-colors hover:text-verde aria-[current]:bg-texto aria-[current]:text-fondo dark:hover:text-verde-claro"
          >
            {label}
          </a>
        ))}
      </div>

      <button
        id="theme-btn"
        class="grid h-9 w-9 place-items-center rounded-full border-2 border-texto/15 transition-colors hover:border-turquesa hover:text-turquesa"
        aria-label={t('theme.toggle')}
      >
        <!-- Luna en modo claro (pasar a oscuro), sol en modo oscuro. -->
        <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button id="menu-btn" class="xl:hidden" aria-label={t('menu')} aria-expanded="false" aria-controls="menu-movil">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <ul id="menu-movil" class="hidden flex-col gap-1 border-t border-texto/10 px-4 pb-4 pt-2 xl:hidden">
    {navLinks.map((l) => (
      <li><a href={l.href} class="block py-2 font-display text-3xl uppercase tracking-wide">{t(l.key)}</a></li>
    ))}
  </ul>
</header>

<script>
  // Se guarda para que la elección se mantenga en próximas visitas.
  document.getElementById('theme-btn')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu-movil')!;

  /** Abre o cierra el menú móvil. */
  function toggle(open: boolean) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    btn.setAttribute('aria-expanded', String(open));
  }

  btn.addEventListener('click', () => toggle(menu.classList.contains('hidden')));
  // Al elegir una sección el menú debe cerrarse para no tapar el contenido.
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));

  // Marca en el header la sección que ocupa el centro de la pantalla.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) =>
          l.getAttribute('href') === `#${e.target.id}` ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current'),
        );
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  links.forEach((l) => {
    const section = document.querySelector(l.getAttribute('href')!);
    if (section) observer.observe(section);
  });
</script>
