---
import { areas } from '../data/site';
import { getLang, term, useT } from '../i18n/ui';
import { collage } from '../data/home';
import { asset, posterFor } from '../data/asset';

const dots = ['bg-verde', 'bg-marron', 'bg-turquesa'];
const clips = collage.clips;

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="inicio" class="relative isolate flex h-[100svh] max-h-[1000px] min-h-[660px] flex-col overflow-hidden border-b-[6px] border-negro">
  <!-- Collage de clips en bucle: se edita desde el panel (Inicio → Collage). -->
  {clips.length > 0 && (
  <div class="collage absolute inset-0 -z-20 grid grid-cols-2 grid-rows-3 md:grid-cols-3 md:grid-rows-2" aria-hidden="true">
    {clips.slice(0, 6).map((c) => (
      <video
        src={asset(c.video)}
        poster={c.poster ? asset(c.poster) : posterFor(c.video)}
        class="h-full w-full object-cover grayscale contrast-125"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    ))}
  </div>
  )}
  <!-- Velo del color de fondo, más denso a la izquierda para que el nombre se lea sobre el collage. -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-fondo via-fondo/90 to-fondo/60" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-marron/10 mix-blend-multiply" aria-hidden="true"></div>

  <img
    src={asset('/img/camera-tripod.png')}
    alt=""
    class="tripod pointer-events-none absolute -bottom-[3%] right-[-14%] -z-10 h-[78%] w-auto max-w-none sm:right-[4%] md:right-[36%] md:h-[calc(100%-4.5rem)]"
  />

  <div class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-4 pb-40 pt-28 sm:px-6 md:pb-24">
    <h1 class="outline-fondo font-display uppercase leading-[0.78] tracking-wide">
      <span class="block text-[clamp(6rem,21vw,17rem)] text-verde dark:text-verde-claro">Edith</span>
      <span class="block text-[clamp(6rem,21vw,17rem)] text-texto">Jordan</span>
    </h1>

    <ul class="mt-8 flex max-w-2xl flex-wrap gap-2">
      {areas.map((p, i) => (
        <li class="flex items-center gap-2 rounded-full bg-texto px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-fondo sm:px-4 sm:py-1.5 sm:text-sm">
          <span class:list={['h-2 w-2 rounded-full', dots[i % dots.length]]}></span>{term(p, lang)}
        </li>
      ))}
    </ul>
  </div>

  <!-- Tarjeta sólida: se lee sobre cualquier foto del collage. -->
  <div class="absolute bottom-8 right-4 bg-negro px-5 py-4 text-crema shadow-[8px_8px_0_0_var(--color-verde)] sm:right-6 md:bottom-14 md:right-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] md:px-7 md:py-5">
    <p class="font-display text-3xl uppercase leading-none tracking-wide sm:text-5xl">{t('hero.degree')}</p>
    <p class="mt-3 inline-block bg-turquesa px-3 py-1 font-display text-xl uppercase leading-none tracking-[0.2em] text-negro sm:text-2xl">UCSG</p>
  </div>
</section>

<script>
  const hero = document.getElementById('inicio')!;
  const clips = [...hero.querySelectorAll<HTMLVideoElement>('.collage video')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  /** Reproduce los clips solo si el hero está en pantalla y no se pidió reducir movimiento. */
  function update(visible: boolean) {
    clips.forEach((v) => (visible && !reduce.matches ? v.play().catch(() => {}) : v.pause()));
  }

  // Seis videos en bucle fuera de pantalla gastarían batería y datos sin que nadie los vea.
  new IntersectionObserver(([e]) => update(e.isIntersecting)).observe(hero);
  reduce.addEventListener('change', () => update(hero.getBoundingClientRect().bottom > 0));
</script>

<style>
  .tripod {
    /* Pivotar desde la base mantiene las patas apoyadas en el borde inferior. */
    transform-origin: 40% 100%;
    transform: rotate(12deg);
    filter: drop-shadow(0 24px 24px rgb(22 19 15 / 0.35));
    animation: settle 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  /* En modo oscuro la cámara negra se perdería en el fondo: un halo crema la recorta. */
  :global([data-theme='dark']) .tripod {
    filter: drop-shadow(0 0 26px rgb(243 233 210 / 0.22));
  }
  /* Contorno del color de fondo: el nombre se separa de la cámara que tiene detrás. */
  .outline-fondo {
    text-shadow:
      3px 0 var(--color-fondo), -3px 0 var(--color-fondo), 0 3px var(--color-fondo), 0 -3px var(--color-fondo),
      2px 2px var(--color-fondo), -2px -2px var(--color-fondo), 2px -2px var(--color-fondo), -2px 2px var(--color-fondo);
  }
  @keyframes settle {
    from { transform: rotate(0deg); opacity: 0; }
    to { transform: rotate(12deg); opacity: 1; }
  }
</style>
