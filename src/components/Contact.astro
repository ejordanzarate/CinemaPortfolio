---
import contact from '../data/contact.json';
import { inlineLogo } from '../data/logo';
import PaintBlob from './PaintBlob.astro';
import { getLang, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [titleA, titleB] = t('contact.title');

const links = [
  { kind: t('contact.email'), value: contact.email, href: `mailto:${contact.email}`, icon: 'mail' },
  { kind: 'Instagram', value: contact.instagram, href: contact.instagramUrl, icon: 'instagram' },
];
---

<section id="contacto" class="relative overflow-hidden bg-verde py-24 text-crema md:py-32">
  <PaintBlob color="#6B4226" rotate={30} class="pointer-events-none absolute -left-28 -top-28 h-80 w-80 opacity-50" />
  <!-- Palabra gigante solo en contorno: llena el fondo sin competir con los enlaces. -->
  <span
    class="outline-word pointer-events-none absolute -bottom-[0.18em] left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-display text-[clamp(8rem,26vw,24rem)] uppercase leading-none tracking-wide text-transparent"
    aria-hidden="true">{t('contact.word')}</span
  >

  <div class="relative mx-auto grid max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-20">
    <div class="flex flex-col justify-center">
      <h2 class="font-display text-[clamp(5rem,14vw,10rem)] uppercase leading-[0.8] tracking-wide">
        {titleA}<span class="text-turquesa">{titleB}</span>
      </h2>
      <div class="mt-4 flex h-[6px] w-40" aria-hidden="true">
        <span class="flex-1 bg-turquesa"></span><span class="flex-1 bg-crema"></span><span class="flex-1 bg-marron"></span>
      </div>
    </div>

    <div class="relative">
      <PaintBlob color="#3FA7A3" rotate={200} class="pointer-events-none absolute -right-8 -top-10 h-28 w-28" />
      <ul class="relative grid gap-4">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.icon === 'instagram' ? '_blank' : undefined}
              rel={l.icon === 'instagram' ? 'noopener' : undefined}
              class="group flex items-center gap-5 bg-fondo p-5 text-texto shadow-[10px_10px_0_0_var(--color-negro)] transition-colors hover:bg-turquesa hover:text-negro sm:p-7"
            >
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-verde text-crema transition-colors group-hover:bg-negro">
                {l.icon === 'mail' ? (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                  </svg>
                ) : (
                  <span class="h-5 w-5" set:html={inlineLogo('instagram')} />
                )}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-marron group-hover:text-negro dark:text-marron-claro">{l.kind}</span>
                <span class="block truncate text-lg font-medium sm:text-2xl">{l.value}</span>
              </span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .outline-word {
    -webkit-text-stroke: 2px rgb(243 233 210 / 0.12);
  }
</style>

