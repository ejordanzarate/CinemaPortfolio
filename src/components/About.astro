---
import { about } from '../data/home';
import { asset } from '../data/asset';
import PaintBlob from './PaintBlob.astro';
import { getLang, localized, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [titleA, titleB] = t('about.title');
---

<section id="sobre-mi" class="relative overflow-hidden py-24 md:py-32">
  <div class:list={['mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 md:gap-20', about.photo && 'md:grid-cols-[5fr_7fr]']}>
    {about.photo && (
    <div class="relative mx-auto w-full max-w-sm md:max-w-none">
      <PaintBlob color="#3FA7A3" rotate={60} class="pointer-events-none absolute -right-10 -top-10 z-10 h-36 w-36 opacity-90" />
      <!-- Bloque desplazado en verde: da profundidad al retrato sin marco literal. -->
      <div class="absolute inset-0 translate-x-4 translate-y-4 bg-verde" aria-hidden="true"></div>
      <img src={asset(about.photo)} alt={localized(about, 'photo_alt', lang) || 'Edith Jordan'} decoding="async" class="relative aspect-[4/5] w-full object-cover grayscale-[30%]" />
    </div>
    )}

    <div>
      <h2 class="font-display text-[clamp(4.5rem,12vw,9rem)] uppercase leading-[0.8] tracking-wide">
        {titleA}<span class="text-marron dark:text-marron-claro">{titleB}</span>
      </h2>
      <div class="mt-4 flex h-[6px] w-40" aria-hidden="true">
        <span class="flex-1 bg-verde"></span><span class="flex-1 bg-marron"></span><span class="flex-1 bg-turquesa"></span>
      </div>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-texto/80 md:text-xl">{localized(about, 'bio', lang)}</p>
    </div>
  </div>
</section>
