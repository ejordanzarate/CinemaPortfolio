---
/** Tarjeta de un trabajo audiovisual: reproductor de YouTube liviano o imagen, título y posición. */
import { youtubeId } from '../data/youtube';
import { asset } from '../data/asset';
import { getLang, localized, term, useT } from '../i18n/ui';

interface Props {
  work: { title: string; title_en?: string; position: string; youtube?: string; image?: string; image_alt?: string; image_alt_en?: string };
  /** A ancho completo: el primero de cada pestaña o grupo sale destacado. */
  featured?: boolean;
  class?: string;
}

const { work: w, featured = false, class: cls } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const title = localized(w, 'title', lang);
---

<article data-position={w.position} class:list={['card group', featured && 'md:col-span-2', cls]}>
  <div class="relative aspect-video overflow-hidden bg-crema/5 ring-1 ring-crema/10">
    {w.youtube ? (
      <button class="yt absolute inset-0" data-id={youtubeId(w.youtube)} aria-label={`${t('play')} ${title}`}>
        <img
          src={`https://i.ytimg.com/vi/${youtubeId(w.youtube)}/maxresdefault.jpg`}
          alt=""
          loading="lazy"
          onload="if(this.naturalWidth<=120)this.src=this.src.replace('maxresdefault','hqdefault')"
          onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')"
          class="h-full w-full object-cover opacity-80 transition duration-700 group-hover:scale-[1.03] group-hover:opacity-100"
        />
        <span class="absolute inset-0 bg-gradient-to-t from-negro/70 to-transparent"></span>
        <span class="absolute inset-0 m-auto grid h-20 w-20 place-items-center rounded-full bg-crema text-negro transition group-hover:scale-110 group-hover:bg-turquesa">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
        </span>
      </button>
    ) : w.image ? (
      <img src={asset(w.image)} alt={localized(w, 'image_alt', lang) || title} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
    ) : null}
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-4 border-b border-crema/15 pb-4">
    <h3 class="font-display text-3xl uppercase tracking-wide md:text-4xl">{title}</h3>
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-turquesa">{term(w.position, lang)}</span>
  </div>
</article>
