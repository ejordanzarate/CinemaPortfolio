---
import { getCollection } from 'astro:content';
import { asset } from '../data/asset';
import { altFor, getLang, localized, useT } from '../i18n/ui';
import grouping from '../data/grouping.json';
import Groups from './Groups.astro';
import Mural from './Mural.astro';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [titleA, titleB] = t('makeup.title');

const looks = (await getCollection('makeup'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((l) => l.data.photos.length > 0);

/** Fotos de un look listas para el mural. */
function photosOf(look: (typeof looks)[number]) {
  const title = localized(look.data, 'title', lang);
  return look.data.photos.map((p, i) => ({ src: asset(p.src), title, alt: altFor(p, title, i + 1, lang) }));
}
---

{looks.length > 0 && (
<section id="maquillaje" class="bg-marron py-24 text-crema md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="font-display text-[clamp(4.5rem,13vw,10rem)] uppercase leading-[0.8] tracking-wide">
      {titleA}<span class="text-crema-oscuro/60">{titleB}</span>
    </h2>
    <div class="mt-4 flex h-[6px] w-40" aria-hidden="true">
      <span class="flex-1 bg-verde"></span><span class="flex-1 bg-crema"></span><span class="flex-1 bg-turquesa"></span>
    </div>

    <div class="mt-12">
      {grouping.makeup ? (
        <Groups groups={looks.map((l) => ({ title: localized(l.data, 'title', lang) }))} theme="marron">
          {(i: number) => <Mural photos={photosOf(looks[i])} eager={i === 0 ? 4 : 0} />}
        </Groups>
      ) : (
        <Mural photos={looks.flatMap(photosOf)} />
      )}
    </div>
  </div>
</section>
)}
