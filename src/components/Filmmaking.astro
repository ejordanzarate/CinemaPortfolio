---
import { getCollection } from 'astro:content';
import { filmmakingRoles } from '../data/site';
import { getLang, localized, term, useT } from '../i18n/ui';
import grouping from '../data/grouping.json';
import Groups from './Groups.astro';
import FilmCard from './FilmCard.astro';

const projects = (await getCollection('videos'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => p.data.works.length > 0);
const works = projects.flatMap((p) => p.data.works);
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [titleA, titleB] = t('film.title');

// Todo junto: pestañas por posición, sólo las que tienen contenido.
const tabs = grouping.videos ? [] : filmmakingRoles.filter((p) => works.some((w) => w.position === p));
const firstOfTab = new Set(tabs.map((t) => works.find((w) => w.position === t)));
---

{works.length > 0 && (
<section id="filmmaking" class="relative overflow-hidden bg-negro py-28 text-crema md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-display text-[clamp(3rem,15vw,11rem)] uppercase leading-[0.8] tracking-wide">
        {titleA}<span class="text-turquesa">{titleB}</span>
      </h2>
      {tabs.length > 0 && (
        <div class="flex flex-wrap gap-2" role="tablist">
          {tabs.map((p, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={p}
              class="tab rounded-full border-2 border-crema/25 px-5 py-2 text-sm font-bold uppercase tracking-[0.15em] transition-colors hover:border-turquesa aria-selected:border-turquesa aria-selected:bg-turquesa aria-selected:text-negro"
            >
              {term(p, lang)}
            </button>
          ))}
        </div>
      )}
    </div>
    <div class="mt-6 flex h-[6px]" aria-hidden="true">
      <span class="flex-1 bg-verde"></span><span class="flex-1 bg-marron"></span><span class="flex-1 bg-turquesa"></span>
    </div>

    <div class="mt-12">
      {grouping.videos ? (
        <Groups groups={projects.map((p) => ({ title: localized(p.data, 'title', lang) }))} theme="negro">
          {(i: number) => (
            <div class="grid gap-6 md:grid-cols-2 md:gap-8">
              {projects[i].data.works.map((w, k) => <FilmCard work={w} featured={k === 0} />)}
            </div>
          )}
        </Groups>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 md:gap-8">
          {works.map((w) => <FilmCard work={w} featured={firstOfTab.has(w)} class={w.position !== tabs[0] ? 'hidden' : undefined} />)}
        </div>
      )}
    </div>
  </div>
</section>
)}

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#filmmaking .tab');
  const cards = [...document.querySelectorAll<HTMLElement>('#filmmaking .card')];

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
      const visible = cards.filter((c) => c.dataset.position === t.dataset.tab);
      cards.forEach((c) => {
        c.classList.toggle('hidden', !visible.includes(c));
        // El primero de cada posición se muestra a ancho completo como destacado.
        c.classList.toggle('md:col-span-2', c === visible[0]);
      });
    }),
  );
</script>
