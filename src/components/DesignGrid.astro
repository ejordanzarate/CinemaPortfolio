---
/**
 * Grilla de piezas de diseño: carruseles deslizables, reels verticales y piezas
 * sueltas. Con `type` usa la grilla propia de ese tipo; sin él, una mixta.
 */
import type { CollectionEntry } from 'astro:content';
import { asset, posterFor } from '../data/asset';
import { youtubeId } from '../data/youtube';
import { altFor, getLang, localized, useT } from '../i18n/ui';

type Piece = CollectionEntry<'design'>['data']['pieces'][number];

interface Props {
  type?: Piece['type'];
  pieces: Piece[];
  class?: string;
  /** Marca el panel de una pestaña (modo todo junto). */
  'data-panel'?: string;
}

const { type, pieces, class: cls, ...attrs } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const title = (p: Piece) => localized(p, 'title', lang);

// Mixta: el reel 9:16 queda más alto que el resto, por eso se alinean arriba.
const mixed = 'grid grid-cols-2 items-start gap-6 md:grid-cols-3';
const grids = {
  // Carruseles: deslizables como en redes, formato 4:5.
  Carrusel: 'grid gap-8 sm:grid-cols-2 lg:grid-cols-3',
  // Reels: vertical 9:16; video subido o YouTube Shorts.
  Reel: 'grid grid-cols-2 gap-4 md:grid-cols-4',
  // Piezas sueltas: afiches, portadas, etc.
  Pieza: 'grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6',
};
const arrow =
  'absolute top-1/2 z-10 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-crema/90 text-negro shadow transition hover:bg-turquesa disabled:pointer-events-none disabled:opacity-0';
---

<div {...attrs} class:list={[type ? grids[type] : mixed, cls]}>
  {pieces.map((p) =>
    p.type === 'Carrusel' ? (
      <article class="carousel">
        <div class="relative aspect-[4/5] overflow-hidden bg-fondo">
          <div class="track flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]">
            {p.images.map((img, i) => {
              const alt = altFor(img, title(p), i + 1, lang);
              return (
              <button class="h-full w-full shrink-0 snap-start" data-lightbox={asset(img.src)} data-alt={alt} aria-label={`${t('enlarge')}: ${alt}`}>
                <img src={asset(img.src)} alt={alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </button>
              );
            })}
          </div>
          <span class="count absolute right-3 top-3 rounded-full bg-negro/75 px-2.5 py-1 text-xs font-bold text-crema">
            1/{p.images.length}
          </span>
          <button class:list={['prev left-3', arrow]} aria-label={t('prev')} disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button class:list={['next right-3', arrow]} aria-label={t('next')} disabled={p.images.length < 2}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
        <div class="mt-3 flex items-center justify-between gap-4">
          <h3 class="font-display text-2xl uppercase tracking-wide">{title(p)}</h3>
          <div class="dots flex gap-1.5" aria-hidden="true">
            {p.images.map((_, i) => (
              <span class:list={['h-1.5 w-1.5 rounded-full transition-colors', i === 0 ? 'bg-texto' : 'bg-texto/20']}></span>
            ))}
          </div>
        </div>
      </article>
    ) : p.type === 'Reel' ? (
      <article>
        <div class="relative aspect-[9/16] overflow-hidden bg-negro">
          {p.video ? (
            <>
              <video
                class="reel h-full w-full object-cover"
                src={asset(p.video)}
                poster={p.images[0] ? asset(p.images[0].src) : posterFor(p.video)}
                muted
                loop
                playsinline
                preload="none"
              ></video>
              <button class="mute absolute bottom-3 right-3 grid h-9 w-9 place-items-center rounded-full bg-negro/70 text-crema transition hover:bg-turquesa hover:text-negro" aria-label={t('sound.on')}>
                <svg class="off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4zM23 9l-6 6M17 9l6 6" /></svg>
                <svg class="on hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></svg>
              </button>
            </>
          ) : p.youtube ? (
            <button class="yt group absolute inset-0" data-id={youtubeId(p.youtube)} aria-label={`${t('play')} ${title(p)}`}>
              <img
                src={p.images[0] ? asset(p.images[0].src) : `https://i.ytimg.com/vi/${youtubeId(p.youtube)}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                class="h-full w-full object-cover"
              />
              <span class="absolute inset-0 m-auto grid h-14 w-14 place-items-center rounded-full bg-crema text-negro transition group-hover:bg-turquesa">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </button>
          ) : p.images[0] ? (
            <img src={asset(p.images[0].src)} alt={altFor(p.images[0], title(p), 1, lang)} loading="lazy" decoding="async" class="h-full w-full object-cover" />
          ) : null}
        </div>
        <h3 class="mt-3 font-display text-2xl uppercase tracking-wide">{title(p)}</h3>
      </article>
    ) : p.images[0] && (
      <article>
        <button class="group block aspect-[4/5] w-full overflow-hidden bg-fondo" data-lightbox={asset(p.images[0].src)} data-alt={altFor(p.images[0], title(p), 1, lang)} aria-label={`${t('enlarge')}: ${altFor(p.images[0], title(p), 1, lang)}`}>
          <img src={asset(p.images[0].src)} alt={altFor(p.images[0], title(p), 1, lang)} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
        </button>
        <h3 class="mt-3 font-display text-2xl uppercase tracking-wide">{title(p)}</h3>
      </article>
    ),
  )}
</div>
